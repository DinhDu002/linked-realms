# The public world (deploy/compose.public.yaml). Copy to deploy/.env and fill in every value;
# docs/runbooks/public-world.md explains each one. deploy/.env holds secrets: never commit it.

# Public names. LAND_BASE_DOMAIN should be a registrable domain of its own (not under the Shell's
# or the Hub's), so a Land cannot set cookies for them.
SHELL_DOMAIN=play.example.org
HUB_DOMAIN=hub.example.org
RELAY_HOST=relay.example.org
LAND_BASE_DOMAIN=example-lands.net

# The Map server image the Shell tells Land owners to run (the default is the project's).
# LAND_IMAGE=ghcr.io/dinhdu002/linked-realms-node:latest

# Let's Encrypt account e-mail, and a Cloudflare API token with Zone.DNS edit on LAND_BASE_DOMAIN
# for the wildcard certificate.
ACME_EMAIL=ops@example.org
CLOUDFLARE_API_TOKEN=

# Secrets: generate each with `openssl rand -hex 32`. HUB_TICKET_KEY must be exactly that: 32
# bytes in hex. Back it up: Map servers trust its address, so a new key means every Land owner
# restarts their Map server (and changes HUB_TICKET_SIGNER if they pinned it).
POSTGRES_PASSWORD=
HUB_TICKET_KEY=
HUB_SESSION_SECRET=

# Comma-separated Character addresses (tlr1...) that may hide Lands.
HUB_ADMINS=
