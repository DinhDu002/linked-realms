# Sample settings for the reference Land kit's Map server (development).
# The Land owner's Character address (tlr1...): the Hub's Land must name them.
LAND_OWNER=
HUB_URL=http://localhost:8787
# Optional pins. Unset, both come from the Hub's GET /keys. The development ticket signer is the
# address of the seed 0x48 repeated 32 times.
# HUB_TICKET_SIGNER=tlr1qqqmkrz7wdckqgrm76sjdmyhslmd8r33gf4s3y4d7qqwwrrpgscdmrcgw5jya
# The Hub's host as statements name it; set it when HUB_URL uses an internal name (compose).
# HUB_DOMAIN=localhost:8787
# RELAY_URL=ws://localhost:8080
# MAP_SERVER_KEY_FILE=.data/map-server-key
# HOST=127.0.0.1
# PORT=2567
# LAND_UI_DIR=../client/dist
