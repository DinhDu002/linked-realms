# The Hub's URL, fixed when the Shell is built. Statements name its host (docs/protocols/identity.md).
VITE_HUB_URL=http://localhost:8787
# The Public node's RPC (docs/protocols/node-rpc.md) and the network the Shell signs for (test or
# dev), fixed when the Shell is built. The CSP lets the Shell call only the Hub and this Node.
VITE_NODE_URL=http://localhost:9445
VITE_NETWORK=test
# The Map server image "Your Land" tells owners to run.
# VITE_LAND_IMAGE=ghcr.io/dinhdu002/linked-realms-node:latest
