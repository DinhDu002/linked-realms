# Dev values only. HUB_TICKET_KEY below is anvil's public account 9 key; never use it outside anvil.
PORT=8787
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hub
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# What clients use to reach the relay / what hub-api polls for online Lands
RELAY_PUBLIC_URL=http://127.0.0.1:8080
RELAY_INTERNAL_URL=http://127.0.0.1:8080
# Signs Travel tickets (a server key that holds no assets); Map servers set HUB_TICKET_SIGNER to its address
HUB_TICKET_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6
# At least 32 characters; generate with: openssl rand -hex 32
HUB_SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# The host[:port] the client is served from; SIWE messages must name it
HUB_SIWE_DOMAIN=localhost:5173
# Comma-separated addresses allowed to hide Lands (empty: nobody)
HUB_ADMINS=
# Comma-separated browser origins allowed by CORS
HUB_ALLOWED_ORIGINS=http://localhost:5173
