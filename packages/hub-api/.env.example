# Dev values only. HUB_TICKET_KEY below is a public development key; never use it outside development.
PORT=8787
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hub
# This Hub's host: the `Hub:` line of every signed statement
HUB_DOMAIN=localhost:8787
# What hub-api polls for online Lands
RELAY_INTERNAL_URL=http://127.0.0.1:8080
# Lands are served at <LAND_URL_SCHEME>://<landId>.<LAND_BASE_DOMAIN>
LAND_BASE_DOMAIN=localhost:8080
LAND_URL_SCHEME=http
# 32-byte ML-DSA-44 seed in hex that signs Travel tickets; generate with: openssl rand -hex 32
HUB_TICKET_KEY=4848484848484848484848484848484848484848484848484848484848484848
# At least 32 characters; generate with: openssl rand -hex 32
HUB_SESSION_SECRET=dev-only-session-secret-change-me-0123456789
# Comma-separated tlr1… addresses allowed to hide Lands (empty: nobody)
HUB_ADMINS=
# Comma-separated browser origins allowed by CORS (the Shell)
HUB_ALLOWED_ORIGINS=http://localhost:5173
# IPs or CIDRs of a reverse proxy in front of the Hub (empty: no proxy)
HUB_TRUSTED_PROXIES=
